{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dresscritic:assessment:1.0.0",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "visualQuality", "briefCompliance", "deterministicGameRequirements", "limitations"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "visualQuality": {"type": "object", "additionalProperties": false, "required": ["status", "score", "observations", "uncertainties"], "properties": {
      "status": {"enum": ["assessed", "unknown"]}, "score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
      "observations": {"$ref": "#/$defs/strings"}, "uncertainties": {"$ref": "#/$defs/strings"}
    }, "allOf": [{"if": {"properties": {"status": {"const": "unknown"}}}, "then": {"properties": {"score": {"type": "null"}}}, "else": {"properties": {"score": {"type": "number"}}}}]},
    "briefCompliance": {"type": "object", "additionalProperties": false, "required": ["status", "scope", "observations", "uncertainties"], "properties": {
      "status": {"enum": ["consistent", "inconsistent", "unknown"]}, "scope": {"const": "provided-summary-only"},
      "observations": {"$ref": "#/$defs/strings"}, "uncertainties": {"$ref": "#/$defs/strings"}
    }},
    "deterministicGameRequirements": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"const": "not-evaluated"}}},
    "limitations": {"$ref": "#/$defs/strings"}
  },
  "$defs": {"strings": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 4096}}}
}
