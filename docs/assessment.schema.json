{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dresscritic:assessment:2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "rubricVersion",
    "captureId",
    "jury",
    "summary",
    "orderCompliance",
    "customerCompatibility",
    "deterministicGameRequirements",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "rubricVersion": {
      "const": "1.0.0"
    },
    "captureId": {
      "type": "string"
    },
    "jury": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "houseId",
          "status",
          "score",
          "remarks"
        ],
        "properties": {
          "houseId": {
            "enum": [
              "harmony",
              "character",
              "avant_garde",
              "atelier"
            ]
          },
          "status": {
            "enum": [
              "assessed",
              "unknown"
            ]
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 10,
            "description": "Runtime validator additionally enforces at most one decimal place."
          },
          "remarks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "unknown"
                }
              }
            },
            "then": {
              "properties": {
                "score": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "score": {
                  "type": "number"
                }
              }
            }
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "houseId": {
                "const": "harmony"
              }
            },
            "required": [
              "houseId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "houseId": {
                "const": "character"
              }
            },
            "required": [
              "houseId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "houseId": {
                "const": "avant_garde"
              }
            },
            "required": [
              "houseId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "houseId": {
                "const": "atelier"
              }
            },
            "required": [
              "houseId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "average",
        "spread",
        "divided",
        "verdict"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "insufficient-evidence"
          ]
        },
        "average": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "spread": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "divided": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "verdict": {
          "enum": [
            "weak",
            "uneven",
            "competent",
            "strong",
            "exceptional",
            "insufficient-evidence"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "insufficient-evidence"
              }
            }
          },
          "then": {
            "properties": {
              "average": {
                "type": "null"
              },
              "spread": {
                "type": "null"
              },
              "divided": {
                "type": "null"
              },
              "verdict": {
                "const": "insufficient-evidence"
              }
            }
          },
          "else": {
            "properties": {
              "average": {
                "type": "number"
              },
              "spread": {
                "type": "number"
              },
              "divided": {
                "type": "boolean"
              }
            }
          }
        }
      ]
    },
    "orderCompliance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "scope",
        "score",
        "remarks"
      ],
      "properties": {
        "status": {
          "enum": [
            "consistent",
            "inconsistent",
            "unknown"
          ]
        },
        "scope": {
          "const": "provided-summary-only"
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10,
          "description": "Runtime validator additionally enforces at most one decimal place."
        },
        "remarks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "score": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "customerCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "scope",
        "score",
        "remarks"
      ],
      "properties": {
        "status": {
          "enum": [
            "consistent",
            "inconsistent",
            "unknown"
          ]
        },
        "scope": {
          "const": "verified-customer-preferences-only"
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10,
          "description": "Runtime validator additionally enforces at most one decimal place."
        },
        "remarks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "score": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "deterministicGameRequirements": {
      "const": "not-evaluated"
    },
    "limitations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    }
  }
}