{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dresscritic:evaluation-input:2.0.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "captureId",
    "capturedAtUtc",
    "garment",
    "order",
    "images",
    "actionRecommendationsAllowed",
    "editorCapabilities",
    "deterministicScores",
    "limitations",
    "assetNames",
    "customer"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "captureId": {
      "type": "string"
    },
    "capturedAtUtc": {
      "type": "string"
    },
    "garment": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "urn:dressmakercritic:garment-snapshot:1.0.0"
        }
      ]
    },
    "order": {
      "type": "object",
      "required": [
        "association",
        "definition",
        "budget",
        "deterministicRequirements",
        "brief"
      ],
      "properties": {
        "association": {
          "type": "string"
        },
        "definition": {
          "type": [
            "object",
            "null"
          ]
        },
        "budget": {
          "type": [
            "integer",
            "null"
          ]
        },
        "deterministicRequirements": {
          "type": "array",
          "description": "Known goal targets, including nullable minimumDistinctColors for ColorVarietyRequirement; actual completion is not evaluated."
        },
        "brief": {
          "type": "object",
          "required": [
            "status",
            "summary",
            "sourceUrl",
            "coverage",
            "requests",
            "constraints",
            "uncertainties"
          ]
        },
        "requirementCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "requirementFields": {
          "type": "array",
          "maxItems": 32,
          "description": "Each wrapper has isolated reference IDs and focused tag/goal roots. Preserve unknown parameters without interpreting them."
        },
        "requirementsStatus": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "images": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "file",
          "sha256",
          "source",
          "binding",
          "width",
          "height"
        ],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^[^/\\\\]+\\.png$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source": {
            "type": "string"
          },
          "view": {
            "type": "string"
          },
          "binding": {
            "enum": [
              "active-state-verified",
              "history-thumbnail-reference-verified",
              "history-display-chain-verified",
              "unverified"
            ]
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2048
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2048
          }
        }
      }
    },
    "actionRecommendationsAllowed": {
      "const": false
    },
    "editorCapabilities": {
      "type": "string"
    },
    "deterministicScores": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assetNames": {
      "type": "array",
      "maxItems": 68,
      "items": {
        "type": "object",
        "required": [
          "guid",
          "assetName",
          "runtimeType"
        ],
        "properties": {
          "guid": {
            "type": "string"
          },
          "assetName": {
            "type": [
              "string",
              "null"
            ]
          },
          "runtimeType": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "customer": {
      "type": "object",
      "required": [
        "status",
        "source",
        "preferences",
        "customerId"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "verified"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "preferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "customerId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
