{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dresscritic:jury-response:2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jury",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "jury": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "houseId",
          "status",
          "score",
          "remarks"
        ],
        "properties": {
          "houseId": {
            "enum": [
              "harmony",
              "character",
              "avant_garde",
              "atelier"
            ]
          },
          "status": {
            "enum": [
              "assessed",
              "unknown"
            ]
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 10,
            "description": "Runtime validator additionally enforces at most one decimal place."
          },
          "remarks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "unknown"
                }
              }
            },
            "then": {
              "properties": {
                "score": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "score": {
                  "type": "number"
                }
              }
            }
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "houseId": {
                "const": "harmony"
              }
            },
            "required": [
              "houseId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "houseId": {
                "const": "character"
              }
            },
            "required": [
              "houseId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "houseId": {
                "const": "avant_garde"
              }
            },
            "required": [
              "houseId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "houseId": {
                "const": "atelier"
              }
            },
            "required": [
              "houseId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "limitations": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    }
  }
}