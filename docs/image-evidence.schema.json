{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dressmakercritic:image-evidence:1.0.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "capturedAtUtc",
    "source",
    "pairing",
    "uiStatus",
    "file",
    "width",
    "height",
    "viewsStatus",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "capturedAtUtc": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": [
        "string",
        "null"
      ]
    },
    "pairing": {
      "type": "string",
      "pattern": "^unpaired:"
    },
    "uiStatus": {
      "type": [
        "string",
        "null"
      ]
    },
    "file": {
      "const": "image.png"
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2048
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2048
    },
    "viewsStatus": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "enum": [
          "image.png",
          "angle-left.png",
          "angle-right.png"
        ]
      }
    }
  },
  "additionalProperties": false
}