{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dressmakercritic:progress-context:1.0.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "capturedAtUtc",
    "scene",
    "source",
    "progressAccessStatus",
    "note",
    "objects"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "capturedAtUtc": {
      "type": [
        "string",
        "null"
      ]
    },
    "scene": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "string"
    },
    "progressAccessStatus": {
      "type": [
        "string",
        "null"
      ]
    },
    "note": {
      "type": "string"
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "status",
        "children"
      ],
      "properties": {
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "member": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "integer"
        },
        "referenceId": {
          "type": "integer"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    }
  }
}