{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dresscritic:context-response:2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "orderCompliance",
    "customerCompatibility",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "orderCompliance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "scope",
        "score",
        "remarks"
      ],
      "properties": {
        "status": {
          "enum": [
            "consistent",
            "inconsistent",
            "unknown"
          ]
        },
        "scope": {
          "const": "provided-summary-only"
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10,
          "description": "Runtime validator additionally enforces at most one decimal place."
        },
        "remarks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "score": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "customerCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "scope",
        "score",
        "remarks"
      ],
      "properties": {
        "status": {
          "enum": [
            "consistent",
            "inconsistent",
            "unknown"
          ]
        },
        "scope": {
          "const": "verified-customer-preferences-only"
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10,
          "description": "Runtime validator additionally enforces at most one decimal place."
        },
        "remarks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "score": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "limitations": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    }
  }
}