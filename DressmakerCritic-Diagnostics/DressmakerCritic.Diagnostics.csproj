<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DressmakerCritic.Diagnostics</AssemblyName>
    <RootNamespace>DressmakerCritic.Diagnostics</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml.Linq" />
    <EmbeddedResource Include="Reference/brief-reference.en.json" LogicalName="DressmakerCritic.BriefReference.en.json" WithCulture="false" />
    <!-- Needed when compiling .NET Framework plugins with dotnet on Linux. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="BepInEx">
      <HintPath>$(DressmakerGameRoot)/BepInEx/core/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(DressmakerGameRoot)/Dressmaker_Data/Managed/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(DressmakerGameRoot)/Dressmaker_Data/Managed/UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(DressmakerGameRoot)/Dressmaker_Data/Managed/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(DressmakerGameRoot)/Dressmaker_Data/Managed/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(DressmakerGameRoot)/Dressmaker_Data/Managed/Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(DressmakerGameRoot)/Dressmaker_Data/Managed/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(DressmakerGameRoot)/Dressmaker_Data/Managed/UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(DressmakerGameRoot)/Dressmaker_Data/Managed/UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(DressmakerGameRoot)/Dressmaker_Data/Managed/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Framework">
      <HintPath>$(DressmakerGameRoot)/Dressmaker_Data/Managed/Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DressmakerMods">
      <HintPath>$(DressmakerGameRoot)/BepInEx/plugins/DressmakerMods.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(DressmakerGameRoot)/Dressmaker_Data/Managed/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(DressmakerGameRoot)' == ''" Text="Pass -p:DressmakerGameRoot=/path/to/Dressmaker" />
    <Error Condition="!Exists('$(DressmakerGameRoot)/Dressmaker.exe')" Text="DressmakerGameRoot must point to the directory containing Dressmaker.exe" />
    <Error Condition="!Exists('$(DressmakerGameRoot)/BepInEx/plugins/DressmakerMods.dll')" Text="Yuuma's Dressmaker ModLoader must be installed in DressmakerGameRoot." />
  </Target>
</Project>
